# ============ mora_bot – Jellyfin 用户管理 Bot 配置 ============
# 复制本文件为 .env 后填写，再启动 Bot。
# 提示：兼容旧键名 SUPER_ADMIN_TG_IDS / ADMIN_TELEGRAM_IDS 均可。

# ---------- 必填：Telegram ----------
# 在 @BotFather 创建 Bot 后获得的 Token
TELEGRAM_BOT_TOKEN=

# 超级管理员 Telegram ID（逗号分隔）。可用 @userinfobot 查询自己的 ID
SUPER_ADMIN_TG_IDS=
# （兼容旧名）ADMIN_TELEGRAM_IDS=

# ---------- 必填：Jellyfin ----------
# Jellyfin 服务器基础地址（须为 https:// 域名）
JELLYFIN_URL=https://jf.example.com

# Jellyfin 管理面板 → 高级 → API 密钥
JELLYFIN_API_KEY=

# 模板用户的 Jellyfin UserId：新注册用户克隆该用户的权限策略（Policy）
JELLYFIN_TEMPLATE_USER_ID=

# ---------- 必填：安全密钥 ----------
# 邀请码/续期码 HMAC 校验椒盐（≥32 字节，请随机生成并妥善保管）
SECURITY_PEPPER=

# ---------- 数据库 ----------
DATABASE_URL=data/mora_bot.db
# 兼容旧名/新名（二选一即可）
# DATABASE_MAX_OPEN_CONNS=4
# DATABASE_MAX_IDLE_CONNS=2
# DATABASE_BUSY_TIMEOUT_MS=5000

# ---------- 性能（一般不用改） ----------
DB_MAX_OPEN_CONNS=16
DB_MAX_IDLE_CONNS=8
DB_BUSY_TIMEOUT_MS=5000

# ---------- 其他 ----------
BRAND=mora
VERBOSE=true

# ---------- 签到 / 果果币商店 ----------
# 每日签到基础果果币
SIGN_BASE_REWARD=5
# 连续签到加成（每满 7 天额外奖励）
SIGN_STREAK_BONUS=1
# 连续签到加成上限（0=不限制）
SIGN_STREAK_BONUS_CAP=10
# 兑换一张续期码的价格（果果币）
PRICE_RENEWAL_CODE=150
# 续期码默认续期天数
DEFAULT_RENEWAL_DAYS=30
# 兑换一张邀请码的价格（果果币，预留）
PRICE_INVITE_CODE=300

# ---------- 账号有效期 ----------
# 使用邀请码注册的新账号默认有效天数（0=永久不过期）
NEW_ACCOUNT_VALID_DAYS=30
# 到期前多少天开始提醒
NOTIFY_BEFORE_DAYS=3

# ---------- 追剧中心 ----------
# 每个用户每天最多提交求剧数量（0=不限）
DRAMA_REQUEST_DAILY_LIMIT=5

# ---------- 通知 ----------
# 求剧工单/系统通知推送到的群（群 ID，可为负数的超级群 ID；0=只私聊管理员）
NOTICE_GROUP_ID=0
# 启动时是否向管理员发送启动通知
BOT_STARTUP_NOTIFY_ADMINS=false

# ---------- 备份计划 ----------
# 每日自动备份小时（服务器本地时间，0-23，-1 关闭）
BACKUP_DAILY_HOUR=3
# 备份文件保留份数
BACKUP_KEEP_COUNT=14
# 备份加密密钥（≥32 字节，与 SECURITY_PEPPER 必须不同；留空则不加密、仅本地保存）
BACKUP_ENCRYPT_KEY=
# 加密备份文件发送到的群/频道 ID（0=仅保存到本地 backups/ 目录）
BACKUP_GROUP_ID=0

# ---------- 性能（一般不用改） ----------
# go-telegram/bot 轮询并发
WORKER_COUNT=32
# 更新队列容量
QUEUE_CAPACITY=512
BOT_ADD_HANDLER_TIMEOUT_SECONDS=30
